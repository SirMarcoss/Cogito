# Database PostgreSQL (driver sincrono psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cogito

# Google Gemini API (SDK google-genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15.0

# Frontend CORS (separati da virgola)
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# Polo culturale di default per fallback geolocalizzazione
DEFAULT_POLO_NOME=Catania
DEFAULT_POLO_LAT=37.5079
DEFAULT_POLO_LNG=15.0830
