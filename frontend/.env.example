# Imposta a "false" per disattivare il dataset mock locale e usare il backend FastAPI reale
VITE_USE_MOCK=true

# In sviluppo locale Vite fa proxy di /api/v1 verso http://localhost:8000
# In produzione (Vercel) imposta l'URL completo del backend FastAPI, es:
# VITE_API_BASE_URL=https://cogito-backend.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1
